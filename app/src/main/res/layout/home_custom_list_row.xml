<?xml version="1.0" encoding="utf-8"?>
<!-- CloudStream Dark: one custom list card (approved mockup). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/custom_row_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_custom_list_card"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/custom_row_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_custom_list_icon"
            android:contentDescription="@null"
            android:padding="10dp"
            android:src="@drawable/ic_list_lines_24"
            app:tint="#C7C7CC" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/custom_row_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="#F2F2F2"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/custom_row_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#A1A1A6"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/custom_row_edit"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_round_icon_ripple"
            android:contentDescription="@string/home_custom_edit"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_baseline_edit_24"
            app:tint="#C7C7CC" />

        <ImageButton
            android:id="@+id/custom_row_delete"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_round_icon_ripple"
            android:contentDescription="@string/home_custom_delete"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_baseline_delete_outline_24"
            app:tint="#C7C7CC" />
    </LinearLayout>

    <TextView
        android:id="@+id/custom_row_use"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_gold_button"
        android:clickable="true"
        android:drawablePadding="8dp"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/home_custom_use"
        android:textColor="#141414"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
